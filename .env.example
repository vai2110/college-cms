# CMS deployment
NODE_ENV=production
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret

# CMS login
ADMIN_USERNAME=your-admin-username

# Preferred: store a bcrypt hash, not a plain password
ADMIN_PASSWORD_HASH=

# Temporary fallback for first setup only. Remove after adding ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=choose-a-strong-password

# Website repository that the CMS reads from and publishes to
WEBSITE_OWNER=vai2110
WEBSITE_REPO=mba-admission-portal
WEBSITE_BRANCH=main

# Fine-grained GitHub token with Contents: Read and write access
# Select only mba-admission-portal if possible.
GITHUB_TOKEN=
